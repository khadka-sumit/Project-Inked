generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique // Link to Supabase auth.users UUID
  fullName  String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  status               OrderStatus      @default(PENDING)
  subtotal             Float
  deliveryCharge       Float
  taxAmount            Float
  totalAmount          Float
  currency             String           @default("NPR")
  paymentProvider      PaymentProvider?
  
  shippingFullName     String
  shippingPhone        String
  shippingEmail        String
  shippingAddressLine1 String
  shippingAddressLine2 String?
  shippingCity         String
  shippingDistrict     String
  shippingProvince     String
  shippingPostalCode   String?
  notes                String?
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items                OrderItem[]
  paymentAttempts      PaymentAttempt[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  productName String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model PaymentAttempt {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  status            PaymentStatus   @default(INITIATED)
  amount            Float
  transactionUuid   String?         @unique // For eSewa
  providerReference String?         // eSewa ref ID or Khalti transaction ID
  pidx              String?         @unique // For Khalti
  rawRequest        Json?
  rawResponse       Json?
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  inquiryType String
  orderNumber String?
  message     String
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime @default(now())
}

model LookbookEntry {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  campaign    String
  imageUrl    String
  description String
  productSlugs String[] // Array of strings (PostgreSQL feature)
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  source    String?
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
  FULFILLED
  REFUNDED
}

enum PaymentProvider {
  ESEWA
  KHALTI
  COD
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum MessageStatus {
  UNREAD
  READ
  RESOLVED
}
